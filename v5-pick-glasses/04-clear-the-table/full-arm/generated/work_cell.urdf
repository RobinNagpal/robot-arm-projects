  <joint name="robotiq_85_base_joint" type="fixed">
    <parent link="gripper_mount_link"/>
    <child link="robotiq_85_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="robotiq_85_left_knuckle_joint" type="revolute">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_left_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="0.03060114 0.0 0.05490452"/>
    <limit effort="50" lower="0.0" upper="0.8" velocity="0.5"/>
  </joint>
  <joint name="robotiq_85_right_knuckle_joint" type="revolute">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_right_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="-0.03060114 0.0 0.05490452"/>
    <limit effort="50" lower="-0.8" upper="0.0" velocity="0.5"/>
    <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="robotiq_85_left_finger_joint" type="fixed">
    <parent link="robotiq_85_left_knuckle_link"/>
    <child link="robotiq_85_left_finger_link"/>
    <origin rpy="0 0 0" xyz="0.03152616 0.0 -0.00376347"/>
  </joint>
  <joint name="robotiq_85_right_finger_joint" type="fixed">
    <parent link="robotiq_85_right_knuckle_link"/>
    <child link="robotiq_85_right_finger_link"/>
    <origin rpy="0 0 0" xyz="-0.03152616 0.0 -0.00376347"/>
  </joint>
  <joint name="robotiq_85_left_inner_knuckle_joint" type="continuous">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_left_inner_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="0.0127 0.0 0.06142"/>
    <mimic joint="robotiq_85_left_knuckle_joint"/>
  </joint>
  <joint name="robotiq_85_right_inner_knuckle_joint" type="continuous">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_85_right_inner_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="-0.0127 0.0 0.06142"/>
    <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="robotiq_85_left_finger_tip_joint" type="continuous">
    <parent link="robotiq_85_left_finger_link"/>
    <child link="robotiq_85_left_finger_tip_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="0.00563134 0.0 0.04718515"/>
    <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="robotiq_85_right_finger_tip_joint" type="continuous">
    <parent link="robotiq_85_right_finger_link"/>
    <child link="robotiq_85_right_finger_tip_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="-0.00563134 0.0 0.04718515"/>
    <mimic joint="robotiq_85_left_knuckle_joint"/>
  </joint>
  <gazebo reference="robotiq_85_left_finger_tip_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>60000.0</kp>
    <kd>30.0</kd>
  </gazebo>
  <gazebo reference="robotiq_85_right_finger_tip_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>60000.0</kp>
    <kd>30.0</kd>
  </gazebo>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="wrist_camera_joint" type="fixed">
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0.050 0.010"/>
    <parent link="robotiq_85_base_link"/>
    <child link="wrist_camera_bottom_screw_frame"/>
  </joint>
  <link name="wrist_camera_bottom_screw_frame"/>
  <joint name="wrist_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.01085 0.009 0.021"/>
    <parent link="wrist_camera_bottom_screw_frame"/>
    <child link="wrist_camera_link"/>
  </joint>
  <link name="wrist_camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0038 -0.009 0"/>
      <geometry>
        <mesh filename="package://realsense2_description/meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0078 -0.009 0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="wrist_camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_depth_frame"/>
  </joint>
  <link name="wrist_camera_depth_frame"/>
  <joint name="wrist_camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_depth_frame"/>
    <child link="wrist_camera_depth_optical_frame"/>
  </joint>
  <link name="wrist_camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="wrist_camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra1_frame"/>
  </joint>
  <link name="wrist_camera_infra1_frame"/>
  <joint name="wrist_camera_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra1_frame"/>
    <child link="wrist_camera_infra1_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="wrist_camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.018 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra2_frame"/>
  </joint>
  <link name="wrist_camera_infra2_frame"/>
  <joint name="wrist_camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra2_frame"/>
    <child link="wrist_camera_infra2_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="wrist_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_color_frame"/>
  </joint>
  <link name="wrist_camera_color_frame"/>
  <joint name="wrist_camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_color_frame"/>
    <child link="wrist_camera_color_optical_frame"/>
  </joint>
  <link name="wrist_camera_color_optical_frame"/>
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>wrist_camera</topic>
      <camera>
        <!-- 87 degrees across, which is what Intel publish for the D405. -->
        <horizontal_fov>1.518</horizontal_fov>
        <!-- One of the camera's own stream sizes, in its real 16:9 shape.
               The shape has to be right, because Gazebo works the vertical
               field of view out from it: at 4:3 this camera would appear to
               see 71 degrees up and down instead of the 56 it really sees.

               The size is the smallest real mode that still resolves the
               table finely enough. A wide lens spreads its pixels over more
               ground, so this camera needs more of them than the 60 degree
               one it replaced: at 424 x 240 a pixel covers 2.0 mm of table
               from the survey height, which is coarser than the millimetre
               the measurements are reported to. At 640 x 360 it covers
               1.33 mm, which is fine, and the frames are still small enough
               to cross the ROS bridge comfortably. -->
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <!-- The camera's real working range. Modelling it as a hard limit is
               stricter than the hardware, which returns noisy depth outside it
               rather than nothing, and that is deliberate: a limit the
               simulator enforces is one that cannot be forgotten. It is also
               what caps SURVEY_HEIGHT in arm/dimensions.py, because a survey
               flown higher than this would be reading depth the camera cannot
               stand behind. -->
        <clip>
          <near>0.07</near>
          <far>0.50</far>
        </clip>
        <optical_frame_id>wrist_camera_depth_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>
  <ros2_control name="work_cell_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <command_interface name="effort">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- The FT 300-S, as ros2_control sees it. The broadcaster reads these and
         publishes a WrenchStamped. The frame is the sensor's own link, because
         that is where the real sensor reads: it sits on the flange and senses
         everything bolted beyond it, which is the coupling, the gripper, the
         camera, and whatever the fingers are holding. -->
    <sensor name="wrist_force">
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
      <param name="frame_id">force_sensor_link</param>
    </sensor>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/dev/null</parameters>
    </plugin>
  </gazebo>
</robot>
