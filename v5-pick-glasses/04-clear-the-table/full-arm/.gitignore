# Made again by the Makefile, and large or machine-specific.
data/*.pkl
data/rl/
generated/*.log
generated/views.json
logs/
weights/vla-*/
weights/*-smoke/
__pycache__/

# The table-by-table runs are kept; each solution's result in them is made again by every run.
!runs/
runs/*/*_result.json
runs/*/*_result.png
