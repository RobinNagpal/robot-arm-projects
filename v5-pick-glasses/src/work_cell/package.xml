<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>work_cell</name>
  <version>0.1.0</version>
  <description>
    The simulated work cell and the task that runs in it: a UR5e with a wrist
    camera measures each drinking glass on a table, picks it up, turns it over
    and stands it on a drying rack. No glass's size is written down anywhere;
    every one of them is measured during the run. Grouped by subject: arm,
    table, glasses, rack, world.
  </description>
  <maintainer email="robinnagpal.tiet@gmail.com">Robin Nagpal</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <!-- Holding a glass is a force job, not a position job: the fingers are
       handed over to a forward command controller on the effort interface
       once the pads are on the glass. -->
  <exec_depend>forward_command_controller</exec_depend>
  <!-- What a glass weighs cannot be seen, only felt. -->
  <exec_depend>force_torque_sensor_broadcaster</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>work_cell_moveit_config</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
