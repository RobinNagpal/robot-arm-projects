<?xml version="1.0"?>
<!-- v2's UR5e, gripper and wrist camera, with the meshes, sensors and
     plugins removed. Written by make_urdf() in joint_torques.py. -->
<robot name="assembly_arm">
  
  
  
  
  
  <link name="world"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  
  
  <link name="base_link"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  <link name="base_link_inertia">
    <inertial>
      <mass value="4.0" />
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertia ixx="0.00443333156" ixy="0.0" ixz="0.0" iyy="0.00443333156" iyz="0.0" izz="0.0072" />
    </inertial>
  </link>
  <link name="shoulder_link">
    <inertial>
      <mass value="3.761" />
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.00193 -0.02561" />
      <inertia ixx="0.0070021" ixy="7.3e-07" ixz="-1.053e-05" iyy="0.00648091" iyz="0.00049994" izz="0.00657286" />
    </inertial>
  </link>
  <link name="upper_arm_link">
    <inertial>
      <mass value="8.058" />
      <origin rpy="0 0 0" xyz="-0.2125 0.0 0.11336" />
      <inertia ixx="0.01505885" ixy="-5.4e-05" ixz="5.63e-06" iyy="0.33388086" iyz="-1.81e-06" izz="0.33247207" />
    </inertial>
  </link>
  <link name="forearm_link">
    <inertial>
      <mass value="2.846" />
      <origin rpy="0 0 0" xyz="-0.2422 0.0 0.0265" />
      <inertia ixx="0.00399632" ixy="-1.365e-05" ixz="0.00137272" iyy="0.07879254" iyz="-6.6e-06" izz="0.0784851" />
    </inertial>
  </link>
  <link name="wrist_1_link">
    <inertial>
      <mass value="1.37" />
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01634 -0.0018" />
      <inertia ixx="0.00165491" ixy="-2.82e-06" ixz="-4.38e-06" iyy="0.00135962" iyz="0.00010157" izz="0.00126279" />
    </inertial>
  </link>
  <link name="wrist_2_link">
    <inertial>
      <mass value="1.3" />
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01634 -0.0018" />
      <inertia ixx="0.00135617" ixy="-2.74e-06" ixz="4.44e-06" iyy="0.00127827" iyz="-5.048e-05" izz="0.00096614" />
    </inertial>
  </link>
  <link name="wrist_3_link">
    <inertial>
      <mass value="0.365" />
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.001159" />
      <inertia ixx="0.00018694" ixy="6e-08" ixz="-1.7e-07" iyy="0.00018908" iyz="-9.2e-07" izz="0.00025756" />
    </inertial>
  </link>
  
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="world" />
    <child link="base_link" />
  </joint>
  
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link" />
    <child link="base_link_inertia" />
    
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia" />
    <child link="shoulder_link" />
    <origin rpy="0 0 0" xyz="0 0 0.1625" />
    <axis xyz="0 0 1" />
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <origin rpy="1.570796327 0 0" xyz="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin rpy="0 0 0" xyz="-0.425 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_1_link" />
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333" />
    <axis xyz="0 0 1" />
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link" />
    <child link="wrist_2_link" />
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 -2.044881182297852e-11" />
    <axis xyz="0 0 1" />
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link" />
    <child link="wrist_3_link" />
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11" />
    <axis xyz="0 0 1" />
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="ft_frame"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link" />
    <child link="ft_frame" />
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0" />
  </joint>
  
  <link name="base"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  <joint name="base_link-base_fixed_joint" type="fixed">
    
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
    <parent link="base_link" />
    <child link="base" />
  </joint>
  
  <link name="flange"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link" />
    <child link="flange" />
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0" />
  </joint>
  
  <link name="tool0"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  <joint name="flange-tool0" type="fixed">
    
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0" />
    <parent link="flange" />
    <child link="tool0" />
  </joint>
  <link name="gripper_body">
    <inertial>
      <origin xyz="0 0 0.025" />
      <mass value="0.8" />
      <inertia ixx="0.00083" ixy="0" ixz="0" iyy="0.00033" iyz="0" izz="0.00083" />
    </inertial>
  </link>
  <joint name="gripper_mount" type="fixed">
    <parent link="tool0" />
    <child link="gripper_body" />
    <origin xyz="0 0 0" />
  </joint>
  <link name="left_finger">
    <inertial>
      <origin xyz="0 0 0.06" />
      <mass value="0.05" />
      <inertia ixx="2.2e-5" ixy="0" ixz="0" iyy="2.2e-5" iyz="0" izz="4.0e-6" />
    </inertial>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_body" />
    <child link="left_finger" />
    <origin xyz="0 0.0075 0.05" />
    <axis xyz="0 1 0" />
    
    <limit effort="25.0" lower="0.0" upper="0.04" velocity="0.1" />
  </joint>
  <link name="right_finger">
    <inertial>
      <origin xyz="0 0 0.06" />
      <mass value="0.05" />
      <inertia ixx="2.2e-5" ixy="0" ixz="0" iyy="2.2e-5" iyz="0" izz="4.0e-6" />
    </inertial>
  </link>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_body" />
    <child link="right_finger" />
    <origin xyz="0 -0.0075 0.05" />
    <axis xyz="0 -1 0" />
    
    <limit effort="25.0" lower="0.0" upper="0.04" velocity="0.1" />
  </joint>
  <link name="wrist_camera_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
  </link>
  
  <joint name="wrist_camera_mount" type="fixed">
    <parent link="gripper_body" />
    <child link="wrist_camera_link" />
    <origin rpy="0 -1.5707963267948966 0" xyz="0.085 0 0.015" />
  </joint>
  <link name="wrist_camera_optical_frame"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="1e-9" /><inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" /></inertial></link>
  <joint name="wrist_camera_optical_joint" type="fixed">
    <parent link="wrist_camera_link" />
    <child link="wrist_camera_optical_frame" />
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0" />
  </joint>
  </robot>
