# Tells MoveItConfigsBuilder which model this configuration describes. The
# robot itself lives in the turn_top_flat package so that the simulator and
# MoveIt are always looking at the same URDF.
moveit_setup_assistant_config:
  urdf:
    package: turn_top_flat
    relative_path: arm/arm.urdf.xacro
  srdf:
    relative_path: config/assembly_arm.srdf
