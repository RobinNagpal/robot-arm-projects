# Built by colcon at the repo root, the way each project's own folder is.
build/
install/
log/

# pixi
.pixi/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# editors / IDEs. IntelliJ's module files are kept, so that the repo opens as
# one project with a module per problem; the rest of .idea/ is per machine.
.idea/
!/.idea/
/.idea/*
!/.idea/modules.xml
!/.idea/misc.xml
!/.idea/vcs.xml
!/.idea/modules/
*.iml
!/.idea/modules/*.iml
.vscode/

# macOS
.DS_Store
